# Copy these into Vercel (Project -> Settings -> Environment Variables)
# and into a file called .env.local if you run the app on a computer.
# Never commit real keys to GitHub.

# Your live site address, no trailing slash. e.g. https://nicely.app
NEXT_PUBLIC_BASE_URL=

# --- Supabase (accounts + database) — the NICELY Supabase project, not Hatch
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (the AI that rewrites messages)
ANTHROPIC_API_KEY=

# --- Stripe (payments) — the NICELY Stripe account, not Hatch
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (start with price_) for the three monthly plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_UNLIMITED=

# --- Business details for the Terms and Privacy pages
# Your support email, e.g. hello@yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=
# Who runs Nicely: your name (sole trader) or company name and number
NEXT_PUBLIC_LEGAL_NAME=
