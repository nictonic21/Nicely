# Copy these into Vercel (Project -> Settings -> Environment Variables)
# and into a file called .env.local if you run the app on a computer.
# Never commit real keys to GitHub.
#
# REQUIRED = the site won't work without it.
# OPTIONAL = a feature switches itself on once it's set.

# Your live site address, no trailing slash. e.g. https://www.yourdomain.com   (REQUIRED)
NEXT_PUBLIC_BASE_URL=

# A long random secret only the server knows. Used to sign unsubscribe links
# and to scramble visitors' IP addresses for the free try. (REQUIRED)
# Make one at https://1password.com/password-generator (64 characters, letters + numbers).
NICELYY_SECRET=

# --- Supabase (accounts + database) — the NICELYY Supabase project, not Hatch   (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (the AI that rewrites messages)   (REQUIRED)
ANTHROPIC_API_KEY=

# --- Stripe (payments) — the NICELYY Stripe account, not Hatch   (REQUIRED)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (start with price_) for the three monthly plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_UNLIMITED=
# Yearly prices (OPTIONAL). The Monthly/Yearly switch appears once all three are set.
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_UNLIMITED_YEARLY=

# --- Business details for the Terms and Privacy pages   (REQUIRED)
# Your support email, e.g. hello@yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=
# Who runs Nicelyy: your name (sole trader) or company name and number
NEXT_PUBLIC_LEGAL_NAME=

# --- Free try on the home page
# Most free tries allowed per day across everyone (OPTIONAL, default 300).
# Each costs about 1-2p, so 300 a day is at most about £6 a day.
TRIAL_DAILY_CAP=
# Cloudflare Turnstile "are you human" check (OPTIONAL but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- "Continue with Google / Apple" buttons (OPTIONAL)
# List the ones you've switched on in Supabase, e.g. google,apple
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Emails: welcome and reminders, sent with Resend (OPTIONAL)
RESEND_API_KEY=
# The sender, e.g. Nicelyy <hello@yourdomain.com>
EMAIL_FROM=

# --- Error alerts with Sentry (OPTIONAL)
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for readable error details:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Owner dashboard at /admin
# Your login email (comma-separate several). Only these can see it.
ADMIN_EMAILS=
